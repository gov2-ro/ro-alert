# Copy to .env (or .env.vps) and edit. Git ignores .env files except this example.
# Run: tools/deploy.sh [--env .env.vps] [--dry-run]

# Target folder. Required. "~/x" means x in the home folder of the target host.
DEPLOY_PATH=/Users/me/Sites/ro-alert

# SSH destination. Leave empty to copy to a folder on this machine.
DEPLOY_HOST=
# DEPLOY_HOST=deploy@lab.gov2.ro
# DEPLOY_PORT=22

# 1 removes stale files inside css/, js/ and vendor/ on the target. Default 0.
DEPLOY_DELETE=0
